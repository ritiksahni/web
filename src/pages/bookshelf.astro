---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const csvPath = join(process.cwd(), 'src/data/books.csv');
const raw = readFileSync(csvPath, 'utf-8');

// Literal exports quote fields that contain commas AND newlines (reviews),
// so this walks the whole file rather than splitting on lines.
function parseCsv(text: string): string[][] {
    const rows: string[][] = [];
    let row: string[] = [];
    let field = '';
    let inQuotes = false;
    for (let i = 0; i < text.length; i++) {
        const char = text[i];
        if (inQuotes) {
            if (char === '"') {
                if (text[i + 1] === '"') {
                    field += '"';
                    i++;
                } else {
                    inQuotes = false;
                }
            } else {
                field += char;
            }
        } else if (char === '"') {
            inQuotes = true;
        } else if (char === ',') {
            row.push(field);
            field = '';
        } else if (char === '\n') {
            row.push(field);
            field = '';
            rows.push(row);
            row = [];
        } else if (char !== '\r') {
            field += char;
        }
    }
    if (field || row.length) {
        row.push(field);
        rows.push(row);
    }
    return rows.filter((r) => r.some((c) => c.trim() !== ''));
}

type Book = {
    title: string;
    author: string;
    status: string;
    rating: number;
    slug: string;
};

const table = parseCsv(raw);
const header = table[0].map((h) => h.trim());
const idx = (name: string) => header.indexOf(name);
const iTitle = idx('Title');
const iAuthor = idx('Author');
const iStatus = idx('Reading Status');
const iRating = idx('My Rating');
const iSlug = idx('Literal Slug');

const all: Book[] = table.slice(1).map((cols) => ({
    title: (cols[iTitle] || '').trim(),
    author: (cols[iAuthor] || '').replace(/,\s*$/, '').trim(),
    status: (cols[iStatus] || '').trim(),
    rating: Number.parseInt(cols[iRating] || '', 10) || 0,
    slug: (cols[iSlug] || '').trim()
}));

// The export repeats books across shelves with conflicting statuses, so keep the
// furthest-along state for each one. Finished beats dropped beats reading beats wishlist.
const PRECEDENCE: Record<string, number> = {
    FINISHED: 4,
    DROPPED: 3,
    IS_READING: 2,
    WANTS_TO_READ: 1,
    NONE: 0
};
const rank = (b: Book) => PRECEDENCE[b.status] ?? 0;
const normalize = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
const keyOf = (b: Book) => `${normalize(b.title)}|${normalize(b.author.split(',')[0] || '')}`;

const bySlug = new Map<string, Book>();
for (const book of all) {
    if (!book.title) continue;
    const existing = bySlug.get(book.slug);
    if (!existing || rank(book) > rank(existing)) bySlug.set(book.slug, book);
}
const byBook = new Map<string, Book>();
for (const book of bySlug.values()) {
    const key = keyOf(book);
    const existing = byBook.get(key);
    if (!existing || rank(book) > rank(existing)) byBook.set(key, book);
}
const books = [...byBook.values()];

const byTitle = (a: Book, b: Book) => a.title.localeCompare(b.title);
const shelfOf = (status: string) => books.filter((b) => b.status === status).sort(byTitle);

const literalUrl = (slug: string) => `https://literal.club/ritiksahni/book/${slug}`;

const shelves = [
    { heading: 'Currently Reading', items: shelfOf('IS_READING'), showCount: false },
    { heading: 'Finished', items: shelfOf('FINISHED'), showCount: true },
    { heading: 'Want to Read', items: shelfOf('WANTS_TO_READ'), showCount: true },
    { heading: 'Dropped', items: shelfOf('DROPPED'), showCount: true }
];
---

<BaseLayout title="Bookshelf" description="Books I've read, I'm reading, and want to read." showHeader={false} wide>
    <section class="full-bleed blue-hero py-8 sm:py-12 mb-12 sm:mb-16">
        <div class="w-full max-w-6xl mx-auto px-4 md:px-8">
            <h1 class="text-5xl sm:text-6xl leading-tight font-serif font-medium tracking-tight">Bookshelf</h1>
            <p class="mt-2 text-lg sm:text-xl max-w-3xl">Tracked on <a class="underline underline-offset-2" href="https://literal.club/ritiksahni" target="_blank" rel="noopener">Literal</a>.</p>
        </div>
    </section>

    <article class="max-w-3xl mb-16 sm:mb-24">
        {
            shelves.filter((shelf) => shelf.items.length > 0).map((shelf) => (
                <section class="mb-14 sm:mb-16">
                    <h2 class="text-2xl font-serif font-medium mb-6">
                        {shelf.heading}
                        {shelf.showCount && <span class="ml-2 text-base font-normal opacity-40">({shelf.items.length})</span>}
                    </h2>
                    <ol class="book-list">
                        {shelf.items.map((b) => (
                            <li class="book-list__item">
                                <a
                                    href={literalUrl(b.slug)}
                                    target="_blank"
                                    rel="noopener"
                                    class="font-medium hover:underline decoration-dashed underline-offset-4 decoration-1"
                                >
                                    {b.title}
                                </a>
                                {b.author && <span class="book-list__author">{b.author}</span>}
                                {b.rating > 0 && (
                                    <span class="book-list__rating" title={`Rated ${b.rating} of 5`}>
                                        {'★'.repeat(b.rating)}
                                    </span>
                                )}
                            </li>
                        ))}
                    </ol>
                </section>
            ))
        }
    </article>
</BaseLayout>

<style>
    .book-list {
        list-style: none;
        margin: 0;
        padding: 0;
        counter-reset: book;
    }
    .book-list__item {
        position: relative;
        padding: 0.55rem 0 0.55rem 2.5rem;
        border-bottom: 1px dashed rgb(var(--color-text-main) / 0.12);
        line-height: 1.45;
    }
    .book-list__item:last-child {
        border-bottom: 0;
    }
    .book-list__item::before {
        counter-increment: book;
        content: counter(book);
        position: absolute;
        left: 0;
        top: 0.55rem;
        width: 1.75rem;
        text-align: right;
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
        opacity: 0.35;
        line-height: 1.6;
    }
    .book-list__author {
        display: block;
        font-size: 0.8125rem;
        opacity: 0.55;
    }
    .book-list__rating {
        display: inline-block;
        margin-left: 0.5rem;
        font-size: 0.7rem;
        letter-spacing: 0.05em;
        color: rgb(var(--color-accent));
        opacity: 0.75;
        white-space: nowrap;
        vertical-align: 0.05em;
    }
    @media (min-width: 640px) {
        .book-list__author {
            display: inline;
            font-size: 0.875rem;
        }
        .book-list__author::before {
            content: ' — ';
            opacity: 0.4;
        }
    }
</style>
