---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const csvPath = join(process.cwd(), 'src/data/books.csv');
const raw = readFileSync(csvPath, 'utf-8');

type Book = {
    title: string;
    authors: string;
    shelves: string;
    slug: string;
    isbn13: string;
};

const rows = raw.trim().split('\n').slice(1);
const books: Book[] = rows.map((row) => {
    const cols: string[] = [];
    let current = '';
    let inQuotes = false;
    for (const char of row) {
        if (char === '"') {
            inQuotes = !inQuotes;
        } else if (char === ',' && !inQuotes) {
            cols.push(current);
            current = '';
        } else {
            current += char;
        }
    }
    cols.push(current);
    return {
        title: cols[1] || '',
        authors: cols[3] || '',
        shelves: cols[8] || '',
        slug: cols[6] || '',
        isbn13: cols[5] || ''
    };
});

const statusOf = (b: Book) => {
    const s = b.shelves;
    if (s.includes('IS_READING')) return 'reading';
    if (s.includes('FINISHED')) return 'finished';
    if (s.includes('DROPPED')) return 'dropped';
    return 'want';
};

const reading = books.filter((b) => statusOf(b) === 'reading');
const finished = books.filter((b) => statusOf(b) === 'finished');
const wantToRead = books.filter((b) => statusOf(b) === 'want');
const dropped = books.filter((b) => statusOf(b) === 'dropped');

const coverUrl = (isbn: string) =>
    isbn ? `https://covers.openlibrary.org/b/isbn/${isbn}-M.jpg` : '';
const literalUrl = (slug: string) => `https://literal.club/ritiksahni/book/${slug}`;
---

<BaseLayout title="Bookshelf" description="Books I've read, I'm reading, and want to read." showHeader={false} wide>
    <section class="full-bleed blue-hero py-8 sm:py-12 mb-12 sm:mb-16">
        <div class="w-full max-w-6xl mx-auto px-4 md:px-8">
            <h1 class="text-5xl sm:text-6xl leading-tight font-serif font-medium tracking-tight">Bookshelf</h1>
            <p class="mt-2 text-lg sm:text-xl max-w-3xl">Tracked on <a class="underline underline-offset-2" href="https://literal.club/ritiksahni" target="_blank" rel="noopener">Literal</a>.</p>
        </div>
    </section>

    <article class="mb-16 sm:mb-24">
        {/* Currently Reading */}
        {reading.length > 0 && (
            <section class="mb-20 sm:mb-24">
                <h2 class="text-2xl font-serif font-medium mb-10">Currently Reading</h2>
                <div class="book-grid book-grid--featured">
                    {reading.map((b) => (
                        <a href={literalUrl(b.slug)} target="_blank" rel="noopener" class="book-card group">
                            <div class="book-cover">
                                {coverUrl(b.isbn13) ? (
                                    <img
                                        src={coverUrl(b.isbn13)}
                                        alt={b.title}
                                        loading="lazy"
                                        class="book-cover__img"
                                    />
                                ) : null}
                                <div class="book-cover__fallback" style={coverUrl(b.isbn13) ? 'display:none' : 'display:flex'}>
                                    <span class="book-cover__fallback-title">{b.title}</span>
                                    <span class="book-cover__fallback-author">{b.authors}</span>
                                </div>
                            </div>
                            <p class="mt-3 text-sm font-medium leading-tight group-hover:underline underline-offset-2">{b.title}</p>
                            <p class="mt-1 text-xs opacity-50 leading-tight">{b.authors}</p>
                        </a>
                    ))}
                </div>
            </section>
        )}

        {/* Finished */}
        <section class="mb-20 sm:mb-24">
            <h2 class="text-2xl font-serif font-medium mb-10">Finished <span class="text-base font-normal opacity-40">({finished.length})</span></h2>
            <div class="book-grid">
                {finished.map((b) => (
                    <a href={literalUrl(b.slug)} target="_blank" rel="noopener" class="book-card group">
                        <div class="book-cover">
                            {coverUrl(b.isbn13) ? (
                                <img
                                    src={coverUrl(b.isbn13)}
                                    alt={b.title}
                                    loading="lazy"
                                    class="book-cover__img"
                                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                                />
                            ) : null}
                            <div class="book-cover__fallback" style={coverUrl(b.isbn13) ? 'display:none' : 'display:flex'}>
                                <span class="book-cover__fallback-title">{b.title}</span>
                                <span class="book-cover__fallback-author">{b.authors}</span>
                            </div>
                        </div>
                        <p class="mt-3 text-sm font-medium leading-tight group-hover:underline underline-offset-2">{b.title}</p>
                        <p class="mt-1 text-xs opacity-50 leading-tight">{b.authors}</p>
                    </a>
                ))}
            </div>
        </section>

        {/* Want to Read */}
        <section class="mb-20 sm:mb-24">
            <h2 class="text-2xl font-serif font-medium mb-10">Want to Read <span class="text-base font-normal opacity-40">({wantToRead.length})</span></h2>
            <div class="book-grid">
                {wantToRead.map((b) => (
                    <a href={literalUrl(b.slug)} target="_blank" rel="noopener" class="book-card group">
                        <div class="book-cover">
                            {coverUrl(b.isbn13) ? (
                                <img
                                    src={coverUrl(b.isbn13)}
                                    alt={b.title}
                                    loading="lazy"
                                    class="book-cover__img"
                                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                                />
                            ) : null}
                            <div class="book-cover__fallback" style={coverUrl(b.isbn13) ? 'display:none' : 'display:flex'}>
                                <span class="book-cover__fallback-title">{b.title}</span>
                                <span class="book-cover__fallback-author">{b.authors}</span>
                            </div>
                        </div>
                        <p class="mt-3 text-sm font-medium leading-tight group-hover:underline underline-offset-2">{b.title}</p>
                        <p class="mt-1 text-xs opacity-50 leading-tight">{b.authors}</p>
                    </a>
                ))}
            </div>
        </section>

        {/* Dropped */}
        {dropped.length > 0 && (
            <section class="mb-16">
                <h2 class="text-2xl font-serif font-medium mb-4">Dropped <span class="text-base font-normal opacity-40">({dropped.length})</span></h2>
                <p class="text-sm opacity-60 leading-relaxed">
                    {dropped.map((b, i) => (
                        <>{i > 0 && <span class="opacity-40"> · </span>}<a href={literalUrl(b.slug)} target="_blank" rel="noopener" class="hover:underline underline-offset-2">{b.title}</a></>
                    ))}
                </p>
            </section>
        )}
    </article>
</BaseLayout>

<style is:global>
    .book-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 2rem 1.25rem;
    }
    .book-grid--featured {
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 2rem 1.5rem;
    }
    @media (min-width: 640px) {
        .book-grid {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 2.5rem 1.5rem;
        }
        .book-grid--featured {
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 2.5rem 2rem;
        }
    }

    .book-card {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .book-cover {
        position: relative;
        width: 100%;
        aspect-ratio: 2 / 3;
        border-radius: 4px;
        overflow: hidden;
        background: rgb(var(--color-bg-muted));
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08), 0 1px 2px rgba(0, 0, 0, 0.06);
        transition: box-shadow 300ms ease, transform 300ms ease;
    }
    .group:hover .book-cover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.13), 0 2px 6px rgba(0, 0, 0, 0.08);
        transform: translateY(-3px);
    }

    .book-cover__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }


    /* Fallback: styled like a real cloth-bound book cover */
    .book-cover__fallback {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.25rem 1rem;
        text-align: center;
        gap: 0.5rem;
        background:
            linear-gradient(145deg, rgba(0,0,0,0.03) 0%, transparent 50%, rgba(0,0,0,0.05) 100%),
            rgb(var(--color-bg-muted));
        border: 1px solid rgba(0, 0, 0, 0.06);
    }
    .book-cover__fallback-title {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 0.75rem;
        line-height: 1.35;
        font-weight: 600;
        color: rgb(var(--color-text-main));
        opacity: 0.7;
    }
    .book-cover__fallback-author {
        font-size: 0.6rem;
        line-height: 1.3;
        color: rgb(var(--color-text-main));
        opacity: 0.4;
        font-style: italic;
    }
    /* Spine edge effect */
    .book-cover__fallback::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(
            to bottom,
            rgba(0,0,0,0.06),
            rgba(0,0,0,0.12),
            rgba(0,0,0,0.06)
        );
    }
</style>

<script is:inline>
document.querySelectorAll('.book-cover__img').forEach(function(img) {
    img.addEventListener('load', function() {
        if (img.naturalWidth <= 1) {
            img.style.display = 'none';
            img.nextElementSibling.style.display = 'flex';
        }
    });
    img.addEventListener('error', function() {
        img.style.display = 'none';
        img.nextElementSibling.style.display = 'flex';
    });
});
</script>
